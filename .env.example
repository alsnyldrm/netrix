NETRIX_DATABASE_URL=mysql+pymysql://netrix:URL_ENCODED_PASSWORD@10.2.0.31/netrix?charset=utf8mb4
NETRIX_REDIS_URL=redis://127.0.0.1:6379/0
NETRIX_ENCRYPTION_KEY=GENERATE_WITH_CRYPTOGRAPHY_FERNET
NETRIX_SETUP_TOKEN=GENERATE_A_RANDOM_32_BYTE_TOKEN
NETRIX_PUBLIC_URL=https://netrix.fbu.edu.tr
NETRIX_SECURE_COOKIES=true
NETRIX_PORT=8101
NETRIX_SAMPLE_RETENTION_DAYS=30
# Set false to pause monitor jobs from the API, scheduler and IPAM discovery.
NETRIX_MONITOR_JOBS_ENABLED=true

# Optional combined public + institutional CA bundle (see docs/ipam-integrations.md).
# SSL_CERT_FILE=/run/secrets/ca-certificates/ca-bundle.pem
# REQUESTS_CA_BUNDLE=/run/secrets/ca-certificates/ca-bundle.pem
